{
	"name": "backdrop-dev/prologue",
	"description": "A clean block starter theme for WordPress, built on Backdrop 2.",
	"type": "wordpress-theme",
	"keywords": [ "block-theme", "starter-theme", "backdrop" ],
	"homepage": "https://github.com/backdrop-dev/prologue",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Benjamin Lu",
			"homepage": "https://github.com/techkodeninja"
		}
	],
	"autoload": {
		"psr-4": {
			"Prologue\\": "app/"
		}
	},
	"require": {
		"php": ">=7.4",
		"backdrop-dev/framework": "^2.0"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpstan/phpstan": "^1.12",
		"phpunit/phpunit": "^9.6",
		"doctrine/instantiator": "^1.5",
		"myclabs/deep-copy": "^1.13"
	},
	"scripts": {
		"lint": "find app functions.php patterns bin tests -name '*.php' -not -path '*/vendor/*' -exec php -l {} \\;",
		"phpcs": "phpcs --standard=phpcs.xml",
		"phpstan": "phpstan analyse --memory-limit=512M",
		"phpunit": "phpunit --testsuite=unit",
		"validate-theme-json": "php tests/validate-theme-json.php",
		"test": [
			"@lint",
			"@validate-theme-json",
			"@phpcs",
			"@phpstan"
		]
	}
}
